# Application database settings; defaults used by setup-db.py and run-backend.py.
DB_NAME=payments
DB_USERNAME=payadmin
DB_PASSWORD=paypassword
DB_HOST=127.0.0.1
DB_PORT=3306
# Allowed client host for the application account. Change for a remote app server.
DB_USER_HOST=localhost

# Existing administrator account used only to provision the database.
DB_ADMIN_USERNAME=root
# Omit to prompt securely, or set to an empty value for a passwordless local admin.
# DB_ADMIN_PASSWORD=your-existing-admin-password
# DB_SOCKET=/tmp/mysql.sock

# Synthetic stock prices with no API key required.
MARKET_PROVIDER=cuckootrade
CUCKOOTRADE_SEED=42
CUCKOOTRADE_GENERATION=1
# Sample conversion for synthetic USD prices; CuckooTrade has no FX feed.
CUCKOOTRADE_USD_EUR_RATE=0.92
# Optional real-data provider: MARKET_PROVIDER=twelve-data
# TWELVE_DATA_API_KEY=your-key

# One day, in milliseconds. Authenticated requests renew the session.
JWT_EXPIRATION_MS=86400000

CUCKOOTRADE_CLOCK=demo
